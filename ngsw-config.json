{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/js/**",
          "/media/**",
          "/font/**",
          "/icons/**",
          "/image/*.svg",
          "/image/LogoAppiField.png",
          "/image/favicon.png",
          "/image/wallesmart.png",
          "/image/map.png",
          "/image/Logo CORDER-Blancsstexte (1).png"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "externes",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**",
          "https://unpkg.com/**",
          "https://cdn.jsdelivr.net/npm/chart.js"
        ]
      }
    }
  ]
}
